rule SBDnsDown "The SB Dns component is unavailable in the SBC subsystem" salience 100 {
    when
        Ctx.Alert.HasCause("LINK_TO_DNSGW_DOWN") &&
        Ctx.Alert.VduPath() == "ims.vdu_sb_logic" &&
        Ctx.Vnfc.HasAnyDownInVDU("ims.vdu_sb_dns")
    then
        Result.Assert(
            "SB_DNS_DOWN",
            "PRIMARY",
            "SB Dns component is unavailable in the SBC subsystem"
        );
        Result.RecommendRestartVNFC(
            Ctx.Vnfc.DownPathsInVDU("ims.vdu_sb_dns")
        );
}
