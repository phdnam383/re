rule SIPGWLoadBalancerDown "The I-CSCF load balancer is unavailable" salience 100 {
    when
        Ctx.Alert.HasCause("LINK_TO_PEER_SIPGW_DOWN") &&
        Ctx.Alert.VduPath() == "ims.vdu_sb_sip_core" &&
        Ctx.Vnfc.HasAnyDownInVDU("ims.vdu_cs_loadbalancer_icscf")
    then
        Result.Assert(
            "SIPGW_DOWN",
            "PRIMARY",
            "the I-CSCF load balancer has no running VNFC, so SIP traffic cannot leave this node"
        );
        Result.RecommendRestartVNFC(
            Ctx.Vnfc.DownPathsInVDU("ims.vdu_cs_loadbalancer_icscf")
        );
}

rule SIPGWPeerUnreachable "The peer SIPGW cannot be reached over the network" salience 90 {
    when
        Ctx.Alert.HasCause("LINK_TO_PEER_SIPGW_DOWN") &&
        Ctx.Alert.VduPath() == "ims.vdu_sb_sip_core" &&
        Ctx.Vnfc.HasAnyDownInVDU("ims.vdu_cs_loadbalancer_icscf") == false &&
        Ctx.Link.PingToRemoteFailed() &&
        Ctx.Vnfc.HasAnyDownInVDU("ims.vdu_cs_sip_icscf")
    then
        Result.Assert(
            "PEER_SIPGW_UNREACHABLE",
            "PRIMARY",
            "every local I-CSCF VNFC is running but the peer does not answer; the fault is on the peer or in the network segment between them"
        );
}

rule SIPGWICSCFDown "The I-CSCF SIP component is unavailable" salience 80 {
    when
        Ctx.Alert.HasCause("LINK_TO_PEER_SIPGW_DOWN") &&
        Ctx.Alert.VduPath() == "ims.vdu_sb_sip_core" &&
        Ctx.Vnfc.HasAnyDownInVDU("ims.vdu_cs_loadbalancer_icscf") == false &&
        Ctx.Link.PingToRemoteSuccess() &&
        Ctx.Vnfc.HasAnyDownInVDU("ims.vdu_cs_sip_icscf")
    then
        Result.Assert(
            "SIPGW_DOWN",
            "PRIMARY",
            "the peer is reachable and the load balancer is up, but a certain VNFC within the I-CSCF's SIP component is not running"
        );
        Result.RecommendRestartVNFC(
            Ctx.Vnfc.DownPathsInVDU("ims.vdu_cs_sip_icscf")
        );
}

rule SIPGWLogicDown "The SIPGW logic component is unavailable" salience 70 {
    when
        Ctx.Alert.HasCause("LINK_TO_PEER_SIPGW_DOWN") &&
        Ctx.Alert.VduPath() == "ims.vdu_sb_sip_core" &&
        Ctx.Vnfc.HasAnyDownInVDU("ims.vdu_cs_loadbalancer_icscf") == false &&
        Ctx.Link.PingToRemoteSuccess() &&
        Ctx.Vnfc.HasAnyDownInVDU("ims.vdu_cs_sip_icscf") == false &&
        Ctx.Vnfc.HasAnyDownInVDU("ims.vdu_cs_logic")
    then
        Result.Assert(
            "SIPGW_DOWN",
            "PRIMARY",
            "the peer is reachable and the I-CSCF path is intact, but a certain VNFC within the SIPGW logic component is not running"
        );
        Result.RecommendRestartVNFC(
            Ctx.Vnfc.DownPathsInVDU("ims.vdu_cs_logic")
        );
}
