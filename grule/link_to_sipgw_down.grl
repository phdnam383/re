        Result.Assert(
            "rc-sipgw-logic-down-" + Subject.Path(),
            "SIPGW_DOWN",
            "SIPGW logic component instance is TERMINATED",
            Subject.Path(),
            "PRIMARY",
            0.35
        );
        Result.Recommend(
            "rc-sipgw-logic-down-" + Subject.Path(),
            "RESTART_VNFC",
            Subject.Path(),
            "REPLACE"
        );
}
