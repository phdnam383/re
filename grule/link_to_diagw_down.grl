rule DIAGWLoadBalancerDown "The DIAGW load balancer is unavailable" salience 100 {
    when
        Ctx.Alerts.HasCause("LINK_TO_PEER_DIAGW_DOWN") &&
        Ctx.Link.IsDown(
            "ims.vdu_sb_diameter_core.vnfc_sb_diameter_core_1",
            "ims.vdu_cs_loadbalancer_diagw.vnfc_cs_loadbalancer_diagw_1"
        ) &&
        Ctx.VNFC.IsDown(
            "ims.vdu_cs_loadbalancer_diagw.vnfc_cs_loadbalancer_diagw_1"
        )
    then
        Result.Assert(
            "rc-diagw-loadbalancer-down",
            "DIAGW_DOWN",
            "DIAGW load balancer is TERMINATED",
            "ims.vdu_cs_loadbalancer_diagw.vnfc_cs_loadbalancer_diagw_1",
            "PRIMARY",
            0.55
        );
        Result.Recommend(
            "rc-diagw-loadbalancer-down",
            "RESTART_VNFC",
            "ims.vdu_cs_loadbalancer_diagw.vnfc_cs_loadbalancer_diagw_1",
            "REPLACE",
            "RESTART"
        );
}

